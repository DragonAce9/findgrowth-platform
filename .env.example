# Tenant salt for HMAC-SHA256 of email and phone at ingest.
# The default below is a development constant. Set a unique secret per tenant in production.
# Identity components are stable for a given salt. Do not rotate it in place: old cuts would not join.
FG_PII_SALT=findgrowth-dev-salt

# Optional salt for deterministic treatment/control assignment. Falls back to FG_PII_SALT.
# FG_ARM_SALT=

# Optional SQLite path. Defaults to data/platform.sqlite. data/ is gitignored.
# FG_DB_PATH=
